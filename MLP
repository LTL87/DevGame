void Softmax(const double &z[], double &p[], int n)
  {
   double maxz = z[0];
   for(int i=1; i<n; i++)
      if(z[i] > maxz)
         maxz = z[i];
   double sum = 0;
   for(int i=0; i<n; i++)
     {
      p[i] = MathExp(z[i] - maxz);
      sum += p[i];
     }
   if(sum <= 0)
      sum = 1e-12;
   for(int i=0; i<n; i++)
      p[i] /= sum;
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
double SoftmaxProb1(const double &logits[])
  {
   double m = MathMax(logits[0], logits[1]);
   double e0 = MathExp(logits[0] - m);
   double e1 = MathExp(logits[1] - m);
   return e1 / (e0 + e1);
  }
