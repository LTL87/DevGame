void OnTick()
  {
   if(!NewBar())
      return;

   static int count=0;
   if(CheckPointer(HL)==POINTER_INVALID || InpTrainModel)
     {if(count<1) {Print("Training Model--> OnTick Unavailable!"); count++;} return;}

   HL.update(idxHL, true);
   if(trade_active==false)
      if(!HL.isNew_Low(idxHL)&&!HL.isNew_High(idxHL))
         return;

   double XLive[];
   LiveSignal s = LiveInference(XLive);
   if(s.valid)
     {
      PrintFormat("MLP Signal: Class %d (Prob: %.2f)", s.cls, s.prob);
      TryEnter(trade,XLive);
     }
   ManageTrade(XLive);
  }

