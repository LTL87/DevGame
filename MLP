double Entropy(const double &p[], int n)
  {
   double e = 0;
   for(int i=0; i<n; i++)
      if(p[i] > 1e-12)
         e -= p[i] * MathLog(p[i]);
   return e;
  }

//==================================================
// UNIFIED FORWARD PASS (Used by Train, Test, and Live)
//==================================================
void InternalForward(const double &x[], double &a1[], double &a2[], double &logits[])
  {
// Layer 1
   for(int j=0; j<HIDDEN1; j++)
     {
      double sum = B1[j];
      for(int i=0; i<FEATURESIZE; i++)
         sum += x[i] * W1[i][j];
      a1[j] = ReLU(sum);
     }
// Layer 2
   for(int j=0; j<HIDDEN2; j++)
     {
      double sum = B2[j];
      for(int i=0; i<HIDDEN1; i++)
         sum += a1[i] * W2[i][j];
      a2[j] = ReLU(sum);
     }
// Output
   for(int k=0; k<NUM_CLASSES; k++)
     {
      double sum = B3[k];
      for(int j=0; j<HIDDEN2; j++)
         sum += a2[j] * W3[j][k];
      logits[k] = sum;
     }
  }

