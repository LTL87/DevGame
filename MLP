//==================================================
// FULL TRAINING ROUTINE
//==================================================
void TrainMLP()
  {
   Print("🚀 Starting MLP Training...");
   if(!InpLoadWeights)
      InitMLP();

// 1. Initialize Output Bias from Priors (Corrected to B3)
   double count0 = 0, count1 = 0;
   for(int i=0; i<TRAINSIZE; i++)
     {
      if(Ytr[i] == 0)
         count0++;
      else
         count1++;
     }

   ClassWeight[0] = TRAINSIZE / (2.0 * count0);
   ClassWeight[1] = TRAINSIZE / (2.0 * count1);

   B3[0] = MathLog((count0/TRAINSIZE) + 1e-9);
   B3[1] = MathLog((count1/TRAINSIZE) + 1e-9);

// Local buffers for the forward pass layers
   double x_in[FEATURESIZE];
   double a1[HIDDEN1], z1[HIDDEN1]; // Activations and pre-activations
   double a2[HIDDEN2], z2[HIDDEN2];
   double logits[NUM_CLASSES], p[NUM_CLASSES];

   double bestLoss = DBL_MAX;
   int stall = 0;
   const double eps = 0.05; // Label smoothing

   for(int e = 0; e < MAX_EPOCHS; e++)
     {
      // Shuffle training data every epoch for better generalization
      ShuffleXY(Xtr, Ytr, TRAINSIZE);

      double epochLoss = 0;

      // ============================
      // TRAINING LOOP (Stochastic Gradient Descent)
      // ============================
      for(int s = 0; s < TRAINSIZE; s++)
        {
         // --- Step 1: Forward Pass (Manual expansion for backprop access) ---
         for(int i=0; i<FEATURESIZE; i++)
            x_in[i] = Xtr[i][s];

         // Layer 1
         for(int j=0; j<HIDDEN1; j++)
           {
            z1[j] = B1[j];
            for(int i=0; i<FEATURESIZE; i++)
               z1[j] += x_in[i] * W1[i][j];
            a1[j] = ReLU(z1[j]);
           }
         // Layer 2
         for(int j=0; j<HIDDEN2; j++)
           {
            z2[j] = B2[j];
            for(int i=0; i<HIDDEN1; i++)
               z2[j] += a1[i] * W2[i][j];
            a2[j] = ReLU(z2[j]);
           }
         // Layer 3 (Logits)
         for(int k=0; k<NUM_CLASSES; k++)
           {
            logits[k] = B3[k];
            for(int j=0; j<HIDDEN2; j++)
               logits[k] += a2[j] * W3[j][k];
           }
         Softmax(logits, p, NUM_CLASSES);

         // --- Step 2: Backpropagation ---

         // Delta Output Layer (Softmax + Cross Entropy)
         double d3[NUM_CLASSES];
         int y = Ytr[s];
         double weight = ClassWeight[y];
         for(int k=0; k<NUM_CLASSES; k++)
           {
            double target = (k == y) ? (1.0 - eps) : (eps / (NUM_CLASSES - 1));
            d3[k] = weight * (p[k] - target);
           }

         // Delta Hidden Layer 2
         double d2[HIDDEN2];
         ArrayInitialize(d2, 0.0);
         for(int j=0; j<HIDDEN2; j++)
           {
            double sum_grad = 0;
            for(int k=0; k<NUM_CLASSES; k++)
               sum_grad += d3[k] * W3[j][k];
            d2[j] = sum_grad * dReLU(z2[j]);
           }

         // Delta Hidden Layer 1
         double d1[HIDDEN1];
         ArrayInitialize(d1, 0.0);
         for(int i=0; i<HIDDEN1; i++)
           {
            double sum_grad = 0;
            for(int j=0; j<HIDDEN2; j++)
               sum_grad += d2[j] * W2[i][j];
            d1[i] = sum_grad * dReLU(z1[i]);
           }

         // --- Step 3: Weight Updates (Gradient Descent) ---

         // Update W3 & B3
         for(int k=0; k<NUM_CLASSES; k++)
           {
            for(int j=0; j<HIDDEN2; j++)
               W3[j][k] -= LR * d3[k] * a2[j];
            B3[k] -= LR * d3[k];
           }
         // Update W2 & B2
         for(int j=0; j<HIDDEN2; j++)
           {
            for(int i=0; i<HIDDEN1; i++)
               W2[i][j] -= LR * d2[j] * a1[i];
            B2[j] -= LR * d2[j];
           }
         // Update W1 & B1
         for(int i=0; i<HIDDEN1; i++)
           {
            for(int f=0; f<FEATURESIZE; f++)
               W1[f][i] -= LR * d1[i] * x_in[f];
            B1[i] -= LR * d1[i];
           }
        }

      // ============================
      // VALIDATION LOOP
      // ============================
      double valLoss = 0;
      for(int v = 0; v < VALSIZE; v++)
        {
         for(int i=0; i<FEATURESIZE; i++)
            x_in[i] = Xva[i][v];
         InternalForward(x_in, a1, a2, logits);
         Softmax(logits, p, NUM_CLASSES);

         int targetY = Yva[v];
         valLoss += -MathLog(p[targetY] + 1e-12);
        }
      valLoss /= VALSIZE;

      if(e % 10 == 0)
         PrintFormat("Epoch %d | Val Loss: %.5f", e, valLoss);

      // --- Early Stopping Logic ---
      if(valLoss < bestLoss - 1e-4)
        {
         bestLoss = valLoss;
         stall = 0;
         if(InpSaveWeights)
            SaveWeights(WeightFileName);
        }
      else
        {
         stall++;
         if(stall >= EARLY_STOP)
           {
            PrintFormat("⏹ Early stopping at epoch %d. Best Val Loss: %.5f", e, bestLoss);
            break;
           }
        }
     }
   Print("✅ Training Complete.");
  }
