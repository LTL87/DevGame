double ScaleFeature(double v, int f)
  {
   return (v - FeatureMin[f]) / (FeatureMax[f] - FeatureMin[f]);
  }
//+------------------------------------------------------------------+
//| Custom ATR calculation on MqlRates                               |
//| inRates   : price series (rates array)                           |
//| startIdx  : bar index to compute ATR at (e.g. bShift)            |
//| period    : ATR period (e.g. 14)                                  |
//+------------------------------------------------------------------+
double CustomATR(const MqlRates &inRates[], int startIdx, int period)
  {
// --- bounds check ---
   if(startIdx + period >= ArraySize(inRates))
      return 0.0;

   double atr = 0.0;

// --- first ATR = simple average of TR ---
   for(int i = startIdx+period; i > startIdx; i--)
     {
      double high = inRates[i].high;
      double low  = inRates[i].low;
      double prevClose = inRates[i+1].close;

      double tr = MathMax(high - low,
                          MathMax(MathAbs(high - prevClose),
                                  MathAbs(low  - prevClose)));

      atr += tr;
     }
   atr /= period;

   return atr;
  }

