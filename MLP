void CreateDataset()
  {
   int hATR = iATR(_Symbol, _Period, 14);
   int filled = 0, safety = 0;
   datetime lastTime = ratesHist[MAX_FWD_BARS].time;

   while(filled < MAXSAMPLES)
     {
      MqlRates x, a, b;
      bool UpSwing = false;
      lastTime = populateHL_XAB(HL, idxHL, x, a, b, UpSwing, lastTime);
      if(lastTime == 0)
         break;

      double XA = MathAbs(a.close - x.close);
      double AB = MathAbs(b.close - a.close);

      double AB_ratio = SafeDiv(AB, XA);

      int bShift = iBarShift_Cust(ratesHist, b.time);
      double atrBuf=CustomATR(ratesHist,bShift,14);

      // Labeling Logic
      double tp = UpSwing ? b.close + XA*TP_MULT : b.close - XA*TP_MULT;
      double sl = UpSwing ? b.close - XA*SL_MULT : b.close + XA*SL_MULT;
      int label = -1;

      for(int f = bShift - 1; f >= 0 && (bShift - f) <= MAX_FWD_BARS; f--)
        {
         double hi = ratesHist[f].high;
         double lo = ratesHist[f].low;
         if(UpSwing)
           {
            if(hi >= tp)
              {
               label = 1;
               break;
              }
            if(lo <= sl)
              {
               label = 0;
               break;
              }
           }
         else
           {
            if(lo <= tp)
              {
               label = 1;
               break;
              }
            if(hi >= sl)
              {
               label = 0;
               break;
              }
           }
        }
      if(label == -1)
         continue;

      Dataset[0][filled] = label;
      Dataset[1][filled] = XA;
      Dataset[2][filled] = AB_ratio;
      Dataset[3][filled] = MathAbs((int)(a.time - x.time)/PeriodSeconds());
      Dataset[4][filled] = MathAbs((int)(b.time - a.time)/PeriodSeconds());
      Dataset[5][filled] = MathAbs((int)(b.time - x.time)/PeriodSeconds());
      Dataset[6][filled] = SafeDiv(XA, Dataset[3][filled]);
      Dataset[7][filled] = SafeDiv(atrBuf, XA);
      filled++;
      Comment("Filled=",filled);
     }
   Print("Dataset Created: ", filled, " samples.");
