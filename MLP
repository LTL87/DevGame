void EvaluateRecallTest()
  {
   double x[];
   ArrayResize(x,FEATURESIZE);

   double z1[HIDDEN1], a1[HIDDEN1];
   double z2[HIDDEN2], a2[HIDDEN2];
   double z3[NUM_CLASSES], p[NUM_CLASSES];

   int tp[NUM_CLASSES];
   int cnt[NUM_CLASSES];
   ArrayInitialize(tp,  0);
   ArrayInitialize(cnt, 0);

   for(int s = 0; s < TESTSIZE; s++)
     {
      // ---- load input
      for(int i = 0; i < FEATURESIZE; i++)
         x[i] = Xte[i][s];

      // ---- forward pass (IDENTICAL to training/validation)
      for(int j = 0; j < HIDDEN1; j++)
        {
         z1[j] = B1[j];
         for(int i = 0; i < FEATURESIZE; i++)
            z1[j] += x[i] * W1[i][j];
         a1[j] = ReLU(z1[j]);
        }

      for(int j = 0; j < HIDDEN2; j++)
        {
         z2[j] = B2[j];
         for(int i = 0; i < HIDDEN1; i++)
            z2[j] += a1[i] * W2[i][j];
         a2[j] = ReLU(z2[j]);
        }

      for(int j = 0; j < NUM_CLASSES; j++)
        {
         z3[j] = B3[j];
         for(int i = 0; i < HIDDEN2; i++)
            z3[j] += a2[i] * W3[i][j];
        }

      Softmax(z3, p,NUM_CLASSES);

      int y    = Yte[s];
      int pred = ArgMax(p);

      cnt[y]++;
      if(pred == y)
         tp[y]++;
     }
   for(int k=0;k<NUM_CLASSES;k++)
     {
      double recall = cnt[k]>0 ? (double)tp[k]/cnt[k] : 0;
      PrintFormat("Class %d Recall = %.3f (%d/%d)",k,recall,tp[k],cnt[k]);
     }

  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void EvaluateByConfidence()
  {
   ResetBuckets();

   for(int i=0;i<VALSIZE;i++)
     {
      double p = ForwardProb1(Xva, i);
      int    y = Yva[i];

      if(p < 0.50)
         continue;

      int b = ProbToBucket(p);
      if(b < 0)
         continue;

      bucket_count[b]++;

      if(y == 1)
         bucket_tp[b]++;
      else
         bucket_fp[b]++;
     }


   Print("=== Confidence Bucket Evaluation (Validation) ===");

   for(int b=0;b<NUM_BUCKETS;b++)
     {
      int tp = bucket_tp[b];
      int fp = bucket_fp[b];
      int fn = bucket_fn[b];
      int n  = bucket_count[b];

      if(n < 20)
         continue;  // statistical sanity

      double precision = (tp + fp) > 0 ? double(tp) / (tp + fp) : 0.0;
      double recall    = (tp + fn) > 0 ? double(tp) / (tp + fn) : 0.0;
      double f1        = (precision + recall) > 0 ?
                         2.0 * precision * recall / (precision + recall) : 0.0;

      double lo = 0.50 + 0.05 * b;
      double hi = lo + 0.05;

      PrintFormat(
         "[%.2f–%.2f] N=%d | P=%.3f R=%.3f F1=%.3f",
         lo, hi, n, precision, recall, f1
      );
     }
  }

//==================================================
// LIVE INFERENCE
//==================================================
struct LiveSignal { bool valid; int cls; double prob; double entropy; };

//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
LiveSignal LiveInference(double &outX[])
  {
   LiveSignal sig;
   sig.valid = false;
   double x_feat[FEATURESIZE], a1[HIDDEN1], a2[HIDDEN2], logits[NUM_CLASSES], p[NUM_CLASSES];
   ArrayResize(outX,FEATURESIZE);
// 1. Build Features
   MqlRates X, A, B;
   bool Up;
   if(populateHL_XAB_Live(HL, idxHL, X, A, B, Up, iTime(_Symbol, _Period, 0)) == 0)
      return sig;

   double XA = MathAbs(A.close - X.close);
   double AB = MathAbs(B.close - A.close);
   double AB_ratio = SafeDiv(AB, XA);

   x_feat[0] = XA;
   x_feat[1] = AB_ratio;
   x_feat[2] = MathAbs((int)(A.time - X.time)/PeriodSeconds());
   x_feat[3] = MathAbs((int)(B.time - A.time)/PeriodSeconds());
   x_feat[4] = MathAbs((int)(B.time - X.time)/PeriodSeconds());
   x_feat[5] = SafeDiv(XA, x_feat[2]);

   int bShift = iBarShift(_Symbol, _Period, B.time);
   double atrBuf[];
   if(CopyBuffer(iATR(_Symbol, _Period, 14), 0, bShift, 1, atrBuf) == 1)
      x_feat[6] = SafeDiv(atrBuf[0], XA);

// 2. Scale & Forward
   for(int f=0; f<FEATURESIZE; f++)
      x_feat[f] = ScaleFeature(x_feat[f], f);
   InternalForward(x_feat, a1, a2, logits);
   Softmax(logits, p, NUM_CLASSES);

   sig.cls = (p[1] > p[0]) ? 1 : 0;
   sig.prob = p[sig.cls];
   sig.entropy = Entropy(p, NUM_CLASSES);
   if(sig.prob > 0.75 && sig.entropy < 0.40)
      sig.valid = true;

   outX[0]=x_feat[0];
   outX[1]=x_feat[1];
   outX[2]=x_feat[2];
   outX[3]=x_feat[3];
   outX[4]=x_feat[4];
   outX[5]=x_feat[5];
   outX[6]=x_feat[6];

   return sig;
  }
//+------------------------------------------------------------------+
void TryEnter(CTrade *_trade,double&_xLive[])
  {
   if(trade_active)
      return;

   double margin;
   double conf = GetConfidence(_xLive,margin);

   if(conf < 0.75)
      return;

   bool isLong = (ForwardProb1Live(_xLive) >= 0.75);
   bool isShort = (ForwardProb1Live(_xLive) <= 0.25);

   if(!isLong && !isShort)
      return;

   double lot = ComputeLot(conf);
   double atr[];
   CopyBuffer(iATR(_Symbol,_Period,14),0,1,2,atr);

   double price = isLong ? SymbolInfoDouble(_Symbol,SYMBOL_ASK)
                  : SymbolInfoDouble(_Symbol,SYMBOL_BID);

   double sl = isLong ? price - 1.2 * atr[0]
               : price + 1.2 * atr[0];

   tck = isLong
         ? _trade.Buy(lot,_Symbol,price,sl,0)
         : _trade.Sell(lot,_Symbol,price,sl,0);

   if(tck > 0)
     {
      trade_active = true;
      entry_conf   = conf;
      entry_margin = margin;
     }
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void ManageTrade(double &_xLive[])
  {
   if(!trade_active)
      return;

   double margin;
   double conf = GetConfidence(_xLive,margin);

// Hard confidence collapse
   if(conf < 0.65)
     {
      trade.PositionClose(_Symbol);
      trade_active = false;
      return;
     }

// Margin decay exit
   if(margin < 0.5 * entry_margin)
     {
      trade.PositionClose(_Symbol);
      trade_active = false;
      return;
     }

// Direction flip
   double p = ForwardProb1Live(_xLive);
   if(p > 0.5 && PositionGetInteger(POSITION_TYPE)==POSITION_TYPE_SELL)
     {
      trade.PositionClose(_Symbol);
      trade_active = false;
     }
   if(p < 0.5 && PositionGetInteger(POSITION_TYPE)==POSITION_TYPE_BUY)
     {
      trade.PositionClose(_Symbol);
      trade_active = false;
     }
  }

