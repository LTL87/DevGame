//+------------------------------------------------------------------+
//| HELPER: Populate HL Structure                                    |
//+------------------------------------------------------------------+
datetime populateHL_XAB(cHighsLows *_HL, int _idx, MqlRates &_x, MqlRates &_a, MqlRates &_b, bool &isUp, datetime start)
  {
   MqlRates hi, lo;
   if(!_HL.getPrevHighRate_Hist(_idx, start, hi) || !_HL.getPrevLowRate_Hist(_idx, start, lo))
      return 0;
   if(hi.time > lo.time)
     {
      _b = hi;
      _a = lo;
      _HL.getPrevHighRate_Hist(_idx, _a.time, _x);
      isUp = false;
     }
   else
     {
      _b = lo;
      _a = hi;
      _HL.getPrevLowRate_Hist(_idx, _a.time, _x);
      isUp = true;
     }
   return _b.time;
  }
//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
datetime populateHL_XAB_Live(cHighsLows *_HL, int _idx, MqlRates &_x, MqlRates &_a, MqlRates &_b, bool &isUp, datetime start)
  {
   MqlRates hi, lo;
   if(!_HL.getPrevHighRate(_idx, start, hi) || !_HL.getPrevLowRate(_idx, start, lo))
      return 0;
   if(hi.time > lo.time)
     {
      _b = hi;
      _a = lo;
      _HL.getPrevHighRate(_idx, _a.time, _x);
      isUp = false;
     }
   else
     {
      _b = lo;
      _a = hi;
      _HL.getPrevLowRate(_idx, _a.time, _x);
      isUp = true;
     }
   return _b.time;
  }

