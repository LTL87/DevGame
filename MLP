//+------------------------------------------------------------------+
int ProbToBucket(double p)
  {
   if(p < 0.50)
      return -1;   // ignore
   int b = int((p - 0.50) / 0.05);
   if(b < 0)
      b = 0;
   if(b >= NUM_BUCKETS)
      b = NUM_BUCKETS - 1;
   return b;
  }

