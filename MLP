void InitMLP()
  {
   double limit1 = MathSqrt(6.0 / (FEATURESIZE + HIDDEN1));
   for(int i=0; i<FEATURESIZE; i++)
      for(int j=0; j<HIDDEN1; j++)
         W1[i][j] = ((double)MathRand()/32767.0*2-1)*limit1;

   double limit2 = MathSqrt(6.0 / (HIDDEN1 + HIDDEN2));
   for(int i=0; i<HIDDEN1; i++)
      for(int j=0; j<HIDDEN2; j++)
         W2[i][j] = ((double)MathRand()/32767.0*2-1)*limit2;

   double limit3 = MathSqrt(6.0 / (HIDDEN2 + NUM_CLASSES));
   for(int i=0; i<HIDDEN2; i++)
      for(int j=0; j<NUM_CLASSES; j++)
         W3[i][j] = ((double)MathRand()/32767.0*2-1)*limit3;

   ArrayInitialize(B1,0);
   ArrayInitialize(B2,0);
   ArrayInitialize(B3,0);
  }

