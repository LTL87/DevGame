void ComputeFeatureScalers()
  {
   for(int f=0; f<FEATURESIZE; f++)
     {
      FeatureMin[f] = DBL_MAX;
      FeatureMax[f] = -DBL_MAX;
     }
   for(int i=0; i<TRAINSIZE; i++)
     {
      for(int f=0; f<FEATURESIZE; f++)
        {
         double v = Xtr[f][i];
         if(v < FeatureMin[f])
            FeatureMin[f] = v;
         if(v > FeatureMax[f])
            FeatureMax[f] = v;
        }
     }
   for(int f=0; f<FEATURESIZE; f++)
     {
      if(MathAbs(FeatureMax[f]-FeatureMin[f]) < 1e-12)
         FeatureMax[f] = FeatureMin[f] + 1e-12;
     }
  }

