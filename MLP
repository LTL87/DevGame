double GetConfidence(double &_xLive[],double &margin)
  {
   static double a1[HIDDEN1];
   static double a2[HIDDEN2];
   static double logits[NUM_CLASSES];

   InternalForward(_xLive, a1, a2, logits);

   double p = SoftmaxProb1(logits);
   margin   = MathAbs(logits[1] - logits[0]);

   return MathMax(p, 1.0 - p);
  }
