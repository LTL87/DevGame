int ArgMax(const double &p[])
  {
   int best = 0;
   double vmax = p[0];
   for(int i = 1; i < NUM_CLASSES; i++)
     {
      if(p[i] > vmax)
        {
         vmax = p[i];
         best = i;
        }
     }
   return best;
  }
