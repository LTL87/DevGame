void ShuffleXY(double &X[][], int &Y[], int samples)
  {
   if(samples <= 1)
      return;

   int features = FEATURESIZE;

   for(int i = samples - 1; i > 0; i--)
     {
      int j = MathRand() % (i + 1);

      // --- swap Y
      int ty = Y[i];
      Y[i] = Y[j];
      Y[j] = ty;

      // --- swap X columns
      for(int f = 0; f < features; f++)
        {
         double tx = X[f][i];
         X[f][i] = X[f][j];
         X[f][j] = tx;
        }
     }
  }
