      Ytr[i] = (int)Dataset[0][src];
      for(int f = 0; f < FEATURESIZE; f++)
         Xtr[f][i] = Dataset[f+1][src];
     }

   PrintFormat("✅ Split OK → Train=%d | Val=%d | Test=%d",
               trainSize, valSize, testSize);
  }

